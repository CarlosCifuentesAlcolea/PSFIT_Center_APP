# Cadena de conexion a tu base de datos MySQL/MariaDB
# En local con XAMPP: usuario "root" y password vacia por defecto
DATABASE_URL=mysql://root:@127.0.0.1:3307/psfitcenter

# Puerto donde correra la API
PORT=4000

# Clave secreta para firmar los tokens de sesion (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Credenciales del usuario admin que se crea en el primer "npm run init-db"
# Obligatorias, no hay valor por defecto. Usa una contrasena fuerte, sobre todo en produccion.
ADMIN_EMAIL=admin@psfit.local
ADMIN_PASSWORD=

# URL del frontend desplegado, para restringir CORS y para construir el enlace
# de "olvide mi contrasena" que se manda por email. Si no se define, usa
# https://psfitcenter-web.onrender.com por defecto.
FRONTEND_URL=https://psfitcenter-web.onrender.com

# API key de Resend (resend.com), para enviar el email de "olvide mi contrasena".
# Se crea gratis en tu cuenta de Resend -> API Keys. Mientras no verifiques un
# dominio propio, los emails se mandan desde onboarding@resend.dev (dominio de pruebas
# de Resend, solo permite enviar a tu propio email de cuenta).
RESEND_API_KEY=
